# Formulaire de contact — livraison des messages
#
# Sans RESEND_API_KEY, le formulaire fonctionne quand même : les messages
# sont simplement écrits dans les logs du serveur (console.info). Pratique
# pour tester, insuffisant en production.
#
# Pour recevoir les messages par e-mail, créez un compte sur https://resend.com
# et renseignez les variables ci-dessous.

# Clé API Resend (obligatoire pour l'envoi réel des e-mails)
RESEND_API_KEY=

# Adresse d'expédition (doit être un domaine vérifié dans Resend)
CONTACT_FROM_EMAIL=site@psychomotriciennenantes.fr

# Adresse de réception des messages (celle de Manuela par défaut)
CONTACT_TO_EMAIL=medom@psychomotricite.com
