# Variables d'environnement
#
# Aucune n'est obligatoire pour démarrer : chaque fonctionnalité s'active
# quand sa variable existe. Le formulaire de contact n'en a pas besoin — il
# ouvre l'application de messagerie du visiteur avec un message pré-rempli
# (aucun envoi par le site, aucun compte à créer).

# --------------------------------------------------------------- Mesure d'audience
#
# Umami (auto-hébergé ou Umami Cloud) : le choix recommandé.
#   NEXT_PUBLIC_UMAMI_SRC       → https://cloud.umami.is/script.js
#                                  ou https://umami.exemple.fr/script.js
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID → l'identifiant du site, donné par Umami
# Auto-hébergement : voir docker-compose.umami.yml à la racine du dépôt.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vercel Web Analytics — à désactiver si Umami est activé.
# Mettre « off » pour ne pas charger le script du tout.
NEXT_PUBLIC_ANALYTICS_VERCEL=

# Vercel Speed Insights — Core Web Vitals sur le trafic réel.
# Mettre « off » pour ne pas le charger.
NEXT_PUBLIC_SPEED_INSIGHTS=

# --------------------------------------------------------------- Vérification

# Balise de vérification Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Balise de vérification Bing Webmaster
NEXT_PUBLIC_BING_SITE_VERIFICATION=
